PORT=3000
SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY="your_private_key_here"

# HOD / Admin login password
SPOT_REGISTRATION_PASSWORD=your_admin_password_here

# Event Coordinator login password
COORDINATOR_PASSWORD=your_coordinator_password_here

# Set to true to force local JSON database mode (enabled automatically if Google credentials are blank)
USE_LOCAL_STORAGE=auto
